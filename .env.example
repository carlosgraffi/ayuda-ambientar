# Copiar a .env.local. Los valores de abajo son los del stack local que
# levanta `npx supabase start`: no son secretos, el CLI genera los mismos
# en todas las máquinas.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Saltea RLS. Sólo para el seed y la Function del borde: NUNCA en el
# cliente ni en un archivo que se despliegue.
SUPABASE_SERVICE_ROLE_KEY=
# Para el mapa de focos. Se pasa en el comando de build.
FIRMS_API_KEY=
# El deploy hook de Cloudflare, para `npm run publicar`. Es el mismo valor
# que está cargado como Secret allá. No lleva autenticación: quien tiene la
# URL puede disparar builds, por eso vive sólo acá y en Cloudflare.
CF_DEPLOY_HOOK_URL=
